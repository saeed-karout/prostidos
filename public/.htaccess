Options -MultiViews

RewriteEngine On
RewriteBase /

# === إعادة توجيه من HTTP إلى HTTPS (مهم جدًا!) ===
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# تجاهل الملفات والمجلدات الحقيقية
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# إعادة توجيه جميع الطلبات الأخرى إلى index.html (لـ SPA)
RewriteRule ^ index.html [L]

# تفعيل Headers الأمان (فقط داخل IfModule)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # HSTS: أرسله فقط على HTTPS
    <If "%{HTTPS} == 'on'">
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    </If>

    # Permissions-Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

Header set Content-Security-Policy "\
  default-src 'self' https:; \
  script-src 'self' 'unsafe-inline' 'unsafe-eval' \
    https://www.googletagmanager.com \
    https://www.google-analytics.com \
    https://www.youtube.com \
    https://www.youtube-nocookie.com \
    https://s.ytimg.com \
    https://analytics.tiktok.com \
    https://ads.tiktok.com \
    https://googleads.g.doubleclick.net \
    https://stats.g.doubleclick.net \
    https://widget.clutch.co; \
  style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://widget.clutch.co; \
  img-src 'self' blob: data: https: https://analytics.tiktok.com https://ads.tiktok.com; \
  font-src 'self' data: https://fonts.gstatic.com; \
  frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://www.googletagmanager.com https://widget.clutch.co https://wa.me https://www.google.com; \
  connect-src 'self' \
    https://www.google-analytics.com \
    https://www.googletagmanager.com \
    https://www.google.com \
    https://googleads.g.doubleclick.net \
    https://stats.g.doubleclick.net \
    https://wa.me \
    https://formspree.io \
    https://api.web3forms.com \
    https://formsubmit.co \
    https://formcarry.com \
    https://emailjs.com \
    https://cdn.jsdelivr.net \
    https://analytics.tiktok.com \
    https://ads.tiktok.com \
    https://business-api.tiktok.com; \
  form-action 'self' https://wa.me; \
  media-src 'self' https:; \
  object-src 'none'; \
  base-uri 'self'; \
  upgrade-insecure-requests;"

    # CORS (ديناميكي وآمن)
    SetEnvIf Origin "^https?://(www\.)?prostdios\.com(:[0-9]+)?$" AllowedOrigin=$0
    SetEnvIf Origin "^https?://localhost(:[0-9]+)?$" AllowedOrigin=$0
    Header always set Access-Control-Allow-Origin "%{AllowedOrigin}e" env=AllowedOrigin
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, HEAD"
    Header always set Access-Control-Allow-Headers "Origin, Content-Type, Accept, Authorization"
    Header always set Access-Control-Allow-Credentials "true"

    # دعم preflight requests
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>

# === إعدادات إضافية للخادم ===
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json
</IfModule>

# Cache-Control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>